# ImageStorage.getPublicUrl() assumes this bucket/container allows public
# read access. If your MinIO/Azure Blob setup uses a private bucket,
# getPublicUrl() will return a URL that does not resolve — do not point
# STORAGE_PROVIDER at a private bucket without revisiting the storage
# adapters (see Global Constraints in docs/superpowers/plans/2026-08-20-scaffold-and-storage.md).
# Local Postgres connection string used by prisma/schema.prisma; adjust for your environment.
DATABASE_URL=postgresql://user:password@localhost:5432/avatar_platform

STORAGE_PROVIDER=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=avatars
MINIO_PUBLIC_URL=http://localhost:9000

# NextAuth + Azure AD SSO for /admin/*. NEXTAUTH_SECRET: any random
# string for local dev (`openssl rand -base64 32`); use a real secret in
# production. AZURE_AD_* come from the FPT App Registration.
#
# GATE NOTE: the master plan (docs/superpowers/plans/2026-08-20-campaign-platform-nextjs.md,
# Task 10) blocks coding this until Team hạ tầng confirms a K8s pod in the
# internal cluster can reach login.microsoftonline.com. That confirmation
# has NOT happened — this was wired anyway for local dev/testing only, on
# an explicit decision to accept the risk of rework if the internal
# network turns out not to reach Azure AD. Do not deploy to the internal
# K8s cluster on the strength of local testing alone.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-string
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Set to "true" to make the single "Đăng nhập với tài khoản FPT" button on
# both / and /admin/login sign in as a fixed local account instead of Azure
# AD (see src/lib/mock-fpt-auth.ts and the dev-login CredentialsProvider in
# src/lib/auth-options.ts — only registered when NODE_ENV === "development"
# and AZURE_AD_CLIENT_ID is unset, so it self-disables once real Azure AD
# credentials are configured). Two fixed accounts:
#   - user@fpt.com.vn  (from /)            -> role "user"
#   - admin@fpt.com.vn (from /admin/login) -> role "admin" (must also be
#     listed in DEV_LOGIN_ADMIN_EMAILS below)
# Leave unset/false once real Azure AD credentials are wired.
NEXT_PUBLIC_DEV_LOGIN_ENABLED=false

# Comma-separated emails allowed to get role "admin" when signing in via
# dev-login (case-insensitive), e.g. admin@fpt.com.vn for the fixed mock
# admin account above. Any other email signing in via dev-login still gets
# in, but only as role "user" — dev-login no longer grants admin to anyone
# who just types an email.
DEV_LOGIN_ADMIN_EMAILS=

# Google Analytics 4 — approved for production use (rà soát chính sách bảo
# mật dữ liệu nội bộ FPT đã duyệt, xem báo cáo kiến trúc mục 5/7).
#
# NEXT_PUBLIC_GA_MEASUREMENT_ID: the GA4 property's Measurement ID
# (G-XXXXXXX). Leave empty to disable tracking entirely — GoogleAnalytics
# renders nothing and trackEvent() no-ops when unset, so this is safe to
# leave blank in local dev.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# GA4_PROPERTY_ID: the numeric GA4 property id (Admin > Property Settings),
# used server-side by the GA4 Data API to pull the admin analytics
# dashboard's "downloads by unit" chart. Leave empty to keep showing the
# illustrative placeholder chart instead of calling the API.
#
# SETUP NOTE: the "unit" event parameter sent with avatar_download must
# first be registered as a custom dimension in GA4 (Admin > Custom
# definitions > Create custom dimension, event-scoped, parameter "unit") —
# GA4 has no API to create this, and it is NOT retroactive to events sent
# before the dimension existed.
GA4_PROPERTY_ID=

# Google service account credentials for the GA4 Data API (@google-analytics/data
# reads this the standard Google Cloud way — via
# GOOGLE_APPLICATION_CREDENTIALS pointing at a service-account JSON key
# file, granted "Viewer" access on the GA4 property). Not needed until
# GA4_PROPERTY_ID above is set.
GOOGLE_APPLICATION_CREDENTIALS=
