# ImageStorage.getPublicUrl() assumes this bucket/container allows public
# read access. If your MinIO/Azure Blob setup uses a private bucket,
# getPublicUrl() will return a URL that does not resolve — do not point
# STORAGE_PROVIDER at a private bucket without revisiting the storage
# adapters (see Global Constraints in docs/superpowers/plans/2026-08-20-scaffold-and-storage.md).
# Local Postgres connection string used by prisma/schema.prisma; adjust for your environment.
DATABASE_URL=postgresql://user:password@localhost:5432/avatar_platform

STORAGE_PROVIDER=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=avatars
MINIO_PUBLIC_URL=http://localhost:9000

# NextAuth + Azure AD SSO for /admin/*. NEXTAUTH_SECRET: any random
# string for local dev (`openssl rand -base64 32`); use a real secret in
# production. AZURE_AD_* come from the FPT App Registration.
#
# GATE NOTE: the master plan (docs/superpowers/plans/2026-08-20-campaign-platform-nextjs.md,
# Task 10) blocks coding this until Team hạ tầng confirms a K8s pod in the
# internal cluster can reach login.microsoftonline.com. That confirmation
# has NOT happened — this was wired anyway for local dev/testing only, on
# an explicit decision to accept the risk of rework if the internal
# network turns out not to reach Azure AD. Do not deploy to the internal
# K8s cluster on the strength of local testing alone.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-string
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
